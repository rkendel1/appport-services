{
  "name": "@feltdb/core",
  "version": "0.10.0",
  "description": "FeltDB Core - Application-facing database with Browser, Local, and Server runtimes. Durable state, reactive APIs.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "feltdb": "bin/feltdb.js",
    "create-feltdb": "bin/create-feltdb.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "import": "./dist/db.js",
      "require": "./dist/db.js",
      "types": "./dist/db.d.ts"
    },
    "./file-db": {
      "import": "./dist/file-db.js",
      "require": "./dist/file-db.js",
      "types": "./dist/file-db.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./migrate": {
      "import": "./dist/migrate/index.js",
      "types": "./dist/migrate/index.d.ts"
    },
    "./studio": {
      "import": "./dist/studio/index.js",
      "types": "./dist/studio/index.d.ts"
    },
    "./wasm": {
      "import": "./dist/wasm/feltdb_wasm.js",
      "types": "./dist/wasm/feltdb_wasm.d.ts"
    },
    "./workspace": {
      "import": "./dist/workspace/index.js",
      "types": "./dist/workspace/index.d.ts"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/index-core.d.ts",
      "import": "./dist/index.browser.js",
      "default": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node ../../tools/stage-core-wasm.mjs && npm run build --workspace @feltdb/react && npm run build --workspace @feltdb/migration-sherpa && npm run build --workspace @feltdb/studio && npm run build --workspace @feltdb/cli && npm run build --workspace create-feltdb && node ../../tools/assemble-core-sdk.mjs",
    "test": "node ../../test-runner.ts",
    "test:workspace-e2e": "node --test test/workspace-connection.e2e.test.mjs test/local-development-authority-read-contract.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "feltdb",
    "database",
    "reactive",
    "state-first",
    "collections",
    "workflows",
    "sync"
  ],
  "author": "FeltDB Contributors",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/feltdb.git",
    "directory": "packages/core"
  },
  "browser": "./dist/index.browser.js"
}
