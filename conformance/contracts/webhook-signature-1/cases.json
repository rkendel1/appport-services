    "secret": "k",
    "body": "{\"id\":\"evt_1\",\"type\":\"invoice.paid\",\"data\":{\"amount\":4200,\"note\":\"café ☕\"}}",
    "timestamp": "2026-09-10T22:30:00.000Z"
   },
   "requirements": [
    "hmac-sha256-rfc2104",
    "hex-lowercase",
    "secret-is-utf8-bytes-unhashed"
   ],
   "security": {
    "rationale": "Secrets of 64 bytes or less are used as the HMAC key directly (RFC 2104). An implementation that pre-hashes the key (sha256(secret)) disagrees here and rejects every genuine signature (assessment F-01)."
   }
