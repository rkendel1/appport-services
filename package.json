{
  "name": "@appport/services",
  "version": "0.2.0",
  "description": "AppPort Services API keys backed by FeltDB",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "appport": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "publish:packages": "sh scripts/publish-packages.sh"
  },
  "keywords": [
    "appport",
    "feltdb",
    "api-keys"
  ],
  "license": "ISC",
  "dependencies": {
    "@feltdb/core": "0.10.0",
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "22.10.2",
    "express": "^4.18.2",
    "typescript": "5.6.3"
  }
}
