{
  "name": "@appport/services",
  "version": "0.7.0",
  "description": "API keys, durable webhooks, background jobs, and provider-neutral secrets for AppPort applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "appport-services": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "ui",
    "vendor/stack-ui",
    "appport.flow",
    "docs/api-keys.md",
    "docs/credentials.md",
    "docs/configuration.md",
    "docs/intelligence.md",
    "docs/capabilities.md",
    "docs/capabilities.json",
    "docs/capability-authority.md",
    "docs/management.md",
    "docs/notifications.md",
    "docs/health.md",
    "CHANGELOG.md",
    "README.md",
    "docs/AUTHORITY.md",
    "docs/WEBHOOK-SECURITY.md",
    "docs/JOB-SECURITY.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/release-versions.mjs check && npm run build && node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "publish:packages": "sh scripts/publish-packages.sh",
    "test:browser": "npm run build && node --test --test-concurrency=1 dist/tests/browser/*.browser.js",
    "check:versions": "node scripts/release-versions.mjs check",
    "release:bump": "node scripts/release-versions.mjs bump"
  },
  "keywords": [
    "appport",
    "feltdb",
    "api-keys"
  ],
  "license": "ISC",
  "dependencies": {
    "@appport/protocol": "^1.0.3",
    "@feltdb/core": "0.15.0",
    "@iarna/toml": "^2.2.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "22.10.2",
    "axe-core": "^4.10.3",
    "playwright-core": "^1.56.1",
    "typescript": "5.6.3"
  }
}
